<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The front camera, for the optional Face scan lock. Only used while a locked screen is being opened or your face is being saved. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Reads which app was on screen and for how long (you switch this on once in Android's settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Reads your phone's call log (who, when, how long), once you allow it inside the app. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Turns phone numbers in the call log into contact names. Optional. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Lets the app look up the names of the apps it sees in that history. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Shows the banner that asks what you plugged your phone into. You can say no when Android asks. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Habit reminders ring at the minute chosen when this is allowed (Settings > Permissions > Exact alarms). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Reads your steps and sleep from Health Connect, once you allow it inside the app. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Optional: the calories your watch or phone counts as burned, for the Food tab. -->
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <!-- Lets the first read go back further than 30 days, if another app has that history. Optional. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Only for the fallback: counts steps with the phone's own step counter. Optional. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Places: knows when you arrive at and leave the places you name. Needs "Allow all the time" to work with the app closed. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Lets the app check your position every minute while you are somewhere it does not know (shows a notification while it does). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The focus timer's banner stays up while the app is in the background (Habits H13). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Only used to suggest a name for a stop you have not named (OpenStreetMap). Nothing else uses the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GPS all day: see whether Wi-Fi is connected and its name (names also need the location permission). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Tracking profiles: switch on while a paired device (your car) is connected. Only names and addresses are read. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 9 and older use Google's own version of the Physical activity permission. -->
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <!-- Sets the places up again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app ask you to stop the phone from putting it to sleep, so places and trips are not missed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets the app see whether Health Connect is installed (Android 13 and older). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".LifeTrackerApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeTracker">
        <!-- Lets Google Play fetch the barcode scanner module when the app is installed. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the app icon: Snap a meal. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Snap a meal: the camera, then the check page. Started by the home-screen button, the icon shortcut and the quick-settings tile. -->
        <activity
            android:name=".QuickPhotoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />
        <receiver
            android:name=".data.CameraWidgetProvider"
            android:exported="true"
            android:label="@string/widget_snap">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/camera_widget_info" />
        </receiver>
        <service
            android:name=".data.CameraTileService"
            android:exported="true"
            android:icon="@drawable/ic_p_camera"
            android:label="@string/tile_snap"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Health Connect asks the app to explain what it does with your data. -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- Receives a tap on the Wall / Power bank / Laptop buttons of the charging banner. -->
        <receiver
            android:name=".data.ChargeTagReceiver"
            android:exported="false" />
        <!-- Receives the buttons of the "Where are you?" notification. -->
        <receiver
            android:name=".data.NameAskReceiver"
            android:exported="false" />
        <!-- Google Play services tells these about places and about the phone being still. -->
        <service
            android:name=".data.PlaceWatchService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
        <service
            android:name=".data.TrackService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
        <receiver
            android:name=".data.GeofenceReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.ActivityTransitionReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.PlacesBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- The focus timer (Habits H13): the running banner, the end alarm and the banner's buttons. -->
        <service
            android:name=".data.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A focus timer for a habit that keeps running with the screen off" />
        </service>
        <receiver
            android:name=".data.FocusReceiver"
            android:exported="false" />
        <!-- Habit reminders (Habits H12): the alarm, the Done and Snooze buttons, and setting the alarms again after a restart. -->
        <receiver
            android:name=".data.HabitReminderReceiver"
            android:exported="false" />
        <!-- Supplement reminders (Food): the alarm and the Taken and Snooze buttons. They are set again by the boot receiver below. -->
        <receiver
            android:name=".data.SupplementReminderReceiver"
            android:exported="false" />
        <!-- Meal and water reminders (Food): the alarms and the glass button. Set again together with the supplement alarms. -->
        <receiver
            android:name=".data.FoodReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.HabitReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
