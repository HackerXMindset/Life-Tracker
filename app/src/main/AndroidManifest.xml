<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reads which app was on screen and for how long (you switch this on once in Android's settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Reads your phone's call log (who, when, how long), once you allow it inside the app. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Turns phone numbers in the call log into contact names. Optional. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Lets the app look up the names of the apps it sees in that history. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Shows the banner that asks what you plugged your phone into. You can say no when Android asks. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LifeTrackerApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeTracker">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Receives a tap on the Wall / Power bank / Laptop buttons of the charging banner. -->
        <receiver
            android:name=".data.ChargeTagReceiver"
            android:exported="false" />
    </application>

</manifest>
